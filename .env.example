# Copiez ce fichier en .env (ou utilisez deploy/install.sh qui génère /etc/mycity/mycity.env)

# Serveur
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
# 1 si l'application est derrière un reverse proxy (nginx, Apache, Caddy…)
TRUST_PROXY=0

# Base SQLite
DB_PATH=./data/mycity.db
# Graine de génération de la ville (ne jamais changer après la mise en service)
CITY_SEED=1337

# Premier accès : code exigé pour créer le compte administrateur (vide = pas de code)
SETUP_TOKEN=
# Optionnel : toute inscription avec cet e-mail reçoit le rôle administrateur
ADMIN_EMAIL=

# Paiements Stripe (vide = mode démo, achats simulés)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur

# Durée des sessions (jours)
SESSION_DAYS=30
